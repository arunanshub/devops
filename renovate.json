{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 9am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "schedule": []
  },
  "devbox": {
    "enabled": false
  },
  "argocd": {
    "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/^kubernetes/.+kustomization\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Group infra kernel updates: ArgoCD, Cilium, sealed-secrets, hcloud-ccm/csi, kured, system-upgrade. The helmfile manager is included so bootstrap chart versions bump in the SAME PR as the adopting Application's targetRevision — a lone-side bump fails `opsctl verify-adoption` in CI.",
      "matchManagers": ["argocd", "helmfile"],
      "matchFileNames": [
        "kubernetes/base/infra/**",
        "kubernetes/bootstrap/**",
        "kubernetes/components/hcloud-ccm/**",
        "kubernetes/components/hcloud-csi/**",
        "kubernetes/components/hcloud-secret/**",
        "kubernetes/components/kured/**",
        "kubernetes/components/system-upgrade-controller/**",
        "kubernetes/components/system-upgrade-plans/**"
      ],
      "groupName": "infra"
    },
    {
      "description": "Group platform service updates: traefik, cert-manager, keda, vpa, cloudflared",
      "matchManagers": ["argocd"],
      "matchFileNames": [
        "kubernetes/base/platform/**",
        "kubernetes/components/cloudflared/**"
      ],
      "groupName": "platform"
    },
    {
      "description": "Group monitoring stack updates: kube-prometheus-stack, tempo",
      "matchManagers": ["argocd"],
      "matchFileNames": [
        "kubernetes/base/monitoring/**"
      ],
      "groupName": "monitoring"
    },
    {
      "description": "Regex versioning for GHCR image: YYYYMMDDHHMMSS-sha tag format",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/arunanshub/arunanshu.dev"],
      "versioning": "regex:^(?<major>\\d{4})(?<minor>\\d{4})(?<patch>\\d{6})-(?<build>[a-f0-9]+)$"
    },
    {
      "description": "Group arunanshu-dev image updates — PR immediately, no schedule, automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/arunanshub/arunanshu.dev"],
      "groupName": "arunanshu-dev",
      "schedule": [],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
