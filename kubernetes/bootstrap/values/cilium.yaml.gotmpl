# Bootstrap-only values. ArgoCD takes over after first sync via
# kubernetes/base/infra/cilium/values.yaml — keep the two in sync so the adoption
# under ServerSideApply is a no-op diff.

# k3s runs with --disable-kube-proxy, so Cilium provides all service routing.
kubeProxyReplacement: true

# API endpoint reached from inside the cluster. Today the static private IP of
# the sole control plane; flip to a Hetzner LB IP when going HA without
# touching anything else.
k8sServiceHost: {{ requiredEnv "K8S_API_ENDPOINT" }}
k8sServicePort: 6443

ipam:
  mode: kubernetes

# VXLAN tunnel mode keeps cross-node pod traffic independent of Hetzner
# Cloud Network pod-CIDR routing. This matches the boring default used by
# established Hetzner k3s projects while retaining Cilium features.
routingMode: tunnel
tunnelProtocol: vxlan

# MTU left at default (0 = auto-detect). Path MTU enforcement via pmtuDiscovery below.

# WireGuard for node-to-node encryption. No-op on a single-node cluster, but
# enabling now keeps the multi-node migration to a Terraform-only change.
encryption:
  enabled: true
  type: wireguard
  nodeEncryption: true
  wireguard:
    persistentKeepalive: 25s
  # WireGuard strict mode — fail CLOSED: drop plaintext cross-node pod-to-pod
  # traffic instead of forwarding it. Mirrors the ArgoCD values; see
  # kubernetes/base/infra/cilium/values.yaml for the full rationale and the
  # operator gates that applied when this was first enabled on the live cluster.
  strictMode:
    egress:
      enabled: true
      cidr: "10.42.0.0/16"
      allowRemoteNodeIdentities: true
    ingress:
      enabled: true

bpf:
  masquerade: true

# BandwidthManager (MQ/FQ qdiscs + EDT pacing) + BBR congestion control for pods.
# BBR helps the high-RTT internet egress path (cloudflared/traefik/webapp); requires
# eBPF host-routing (on) + kernel >=5.18 (6.8). Applies to NEW sockets only — existing
# pods flip on their next restart. Orthogonal to VXLAN+WireGuard. Revert = both keys
# false + rolling per-node `kubectl -n kube-system delete pod -l k8s-app=cilium`
# (qdisc/sysctl persist until node reboot, benign). Verify: `just verify-mtu` + cilium status.
bandwidthManager:
  enabled: true
  bbr: true

pmtuDiscovery:
  enabled: true
  packetizationLayerPMTUDMode: "always"

extraConfig:
  enable-gateway-api: "false"
  enable-gateway-api-secrets-sync: "false"

resources:
  requests:
    cpu: 100m
    memory: 320Mi

# NetworkPolicies are ENFORCED (cilium default, kept explicit to match the
# ArgoCD values). See kubernetes/base/infra/cilium/values.yaml.
policyAuditMode: false

operator:
  replicas: 2
  resources:
    requests:
      cpu: 25m
      memory: 160Mi
  # Metrics exposure only. The ServiceMonitor stays ArgoCD-side — its CRD does
  # not exist at bootstrap time (declared as an ignore in opsctl verify-adoption).
  prometheus:
    enabled: true

# Traefik owns Gateway routing. No desired Cilium policy uses L7/DNS/FQDN
# enforcement or CiliumEnvoyConfig, so the chart's otherwise-default standalone
# Envoy DaemonSet has no consumer. Re-enable before adding any of those features.
envoy:
  enabled: false

# Metrics exposure only; ServiceMonitor is ArgoCD-side (CRD absent at bootstrap).
prometheus:
  enabled: true

# Traefik owns the GatewayClass; Cilium Gateway API disabled.
# ref: https://claude.ai/share/589a7ce8-eea1-4043-aaab-69d4d6ee9333
gatewayAPI:
  enabled: false

# Use the host's systemd-managed cgroup2 mount rather than Cilium's private
# one. Both are v2; this just avoids the duplicate mount and gives Hubble
# full visibility into the host cgroup tree for flow→process correlation.
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

# Hubble: enable Relay (flow aggregation) and UI (web visualizer). The certgen
# CronJob (not Helm's genCA) generates cilium-ca and hubble-server-certs to
# keep ArgoCD diffs deterministic; rotation every 4 months is non-disruptive
# thanks to Hubble's hot-reload.
hubble:
  relay:
    enabled: true
  ui:
    enabled: true
  tls:
    auto:
      method: cronJob
  # Hubble metrics agent config (drop visibility surfaces MTU/policy issues).
  # The serviceMonitor and Grafana dashboards stay ArgoCD-side: the CRD and the
  # monitoring namespace do not exist at bootstrap time (declared ignores in
  # opsctl verify-adoption).
  metrics:
    enabled:
      - drop
      - tcp
      - "flow:sourceContext=namespace;destinationContext=namespace"
      - icmp
      - "dns:query;ignoreAAAA"
