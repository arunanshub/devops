# Bootstrap-only values. ArgoCD takes over after first sync via
# kubernetes/base/infra/cilium/values.yaml — keep the two in sync so the adoption
# under ServerSideApply is a no-op diff.

# k3s runs with --disable-kube-proxy, so Cilium provides all service routing.
kubeProxyReplacement: true

# API endpoint reached from inside the cluster. Today the static private IP of
# the sole control plane; flip to a Hetzner LB IP when going HA without
# touching anything else.
k8sServiceHost: {{ requiredEnv "K8S_API_ENDPOINT" }}
k8sServicePort: 6443

ipam:
  mode: kubernetes

# VXLAN tunnel mode keeps cross-node pod traffic independent of Hetzner
# Cloud Network pod-CIDR routing. This matches the boring default used by
# established Hetzner k3s projects while retaining Cilium features.
routingMode: tunnel
tunnelProtocol: vxlan

# WireGuard for node-to-node encryption. No-op on a single-node cluster, but
# enabling now keeps the multi-node migration to a Terraform-only change.
encryption:
  enabled: true
  type: wireguard
  nodeEncryption: true

operator:
  replicas: 2

# Traefik owns the GatewayClass; Cilium Gateway API disabled.
# ref: https://claude.ai/share/589a7ce8-eea1-4043-aaab-69d4d6ee9333
gatewayAPI:
  enabled: false

# Use the host's systemd-managed cgroup2 mount rather than Cilium's private
# one. Both are v2; this just avoids the duplicate mount and gives Hubble
# full visibility into the host cgroup tree for flow→process correlation.
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

# Hubble: enable Relay (flow aggregation) and UI (web visualizer). The certgen
# CronJob (not Helm's genCA) generates cilium-ca and hubble-server-certs to
# keep ArgoCD diffs deterministic; rotation every 4 months is non-disruptive
# thanks to Hubble's hot-reload.
hubble:
  relay:
    enabled: true
  ui:
    enabled: true
  tls:
    auto:
      method: cronJob
