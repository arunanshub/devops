# Bootstrap-only values. ArgoCD takes over after first sync via
# kubernetes/infra/cilium/values.yaml — keep the two in sync so the adoption
# under ServerSideApply is a no-op diff.

# k3s runs with --disable-kube-proxy, so Cilium provides all service routing.
kubeProxyReplacement: true

# API endpoint reached from inside the cluster. Today the static private IP of
# the sole control plane; flip to a Hetzner LB IP when going HA without
# touching anything else.
k8sServiceHost: {{ requiredEnv "K8S_API_ENDPOINT" }}
k8sServicePort: 6443

ipam:
  mode: kubernetes

# Native routing over the Hetzner Cloud Network. hccm programs per-node
# pod-CIDR routes on the Network, so packets traverse the private subnet
# without VXLAN/Geneve encapsulation. Pod CIDR = k3s default.
routingMode: native
ipv4NativeRoutingCIDR: 10.42.0.0/16
autoDirectNodeRoutes: false
endpointRoutes:
  enabled: true

# WireGuard for node-to-node encryption. No-op on a single-node cluster, but
# enabling now keeps the multi-node migration to a Terraform-only change.
encryption:
  enabled: true
  type: wireguard
  nodeEncryption: true

operator:
  # Bump to 2 when a second control plane joins.
  replicas: 1

gatewayAPI:
  enabled: true

# Generate cilium-ca and hubble-server-certs via the certgen CronJob instead
# of Helm's genCA. Helm-side generation is non-deterministic per render, which
# makes ArgoCD perpetually OutOfSync. The CronJob manages both Secrets and
# rotates them defensively (default: every 4 months). Hubble hot-reloads, so
# rotation is non-disruptive.
hubble:
  tls:
    auto:
      method: cronJob
